{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "metrics": [
          [ "WasmPulse/ServerlessEngine", "ColdStartLatencyUs", "TenantId", "my-app", { "stat": "Average", "label": "Cold Start (µs)" } ],
          [ "...", "ExecutionTimeUs", "TenantId", "my-app", { "stat": "Average", "label": "Execution Run (µs)" } ],
          [ "...", "TotalLatencyUs", "TenantId", "my-app", { "stat": "Average", "label": "Total Latency (µs)" } ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "title": "⚡ Microsecond Latency Telemetry (Cold Start vs Execution)",
        "period": 10,
        "yAxis": {
          "left": {
            "label": "Microseconds (µs)",
            "min": 0
          }
        }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "metrics": [
          [ "WasmPulse/ServerlessEngine", "Invocations", { "stat": "Sum", "color": "#2ca02c" } ],
          [ ".", "Errors", { "stat": "Sum", "color": "#d62728" } ]
        ],
        "view": "timeSeries",
        "stacked": true,
        "region": "us-east-1",
        "title": "🚀 Invocations & Error Rates",
        "period": 10
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "metrics": [
          [ "WasmPulse/ServerlessEngine", "FuelConsumed", { "stat": "Sum", "color": "#ff7f0e" } ]
        ],
        "view": "bar",
        "region": "us-east-1",
        "title": "🔥 CPU Fuel Consumed (Instruction Metering)",
        "period": 60
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "metrics": [
          [ "WasmPulse/HostMetrics", "cpu_usage_active", { "stat": "Average" } ],
          [ ".", "mem_used_percent", { "stat": "Average" } ]
        ],
        "view": "timeSeries",
        "region": "us-east-1",
        "title": "💻 EC2 Host Virtual Machine Utilization (CPU & RAM %)",
        "period": 60
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 12,
      "width": 24,
      "height": 6,
      "properties": {
        "query": "SOURCE '/aws/ec2/wasmpulse' | fields @timestamp, @message | sort @timestamp desc | limit 50",
        "region": "us-east-1",
        "title": "📜 Live Sandboxed Wasm Logs & CloudWatch EMF Stream",
        "view": "table"
      }
    }
  ]
}
